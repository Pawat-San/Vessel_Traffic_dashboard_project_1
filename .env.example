# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: overrides the browser tab title + dashboard header brand text.
# Leave unset to keep the generic default ("Vessel Schedule  Dashboard").
# Set the real company name only in the deployment environment, never here.
# APP_TITLE=

# Security & Secrets
# Examples below are for development only and are rejected in production.
# Production: generate each value independently (32 random bytes, 64 hex chars):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use different values for all three secrets; never commit real credentials.
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-replace-in-production
COOKIE_SECRET=super-secret-cookie-key-replace-in-production

# Security Header Config (CORS)
CORS_ORIGIN=http://localhost:3000

# Rate Limiter
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=100 # limit each IP to 100 requests per windowMs

# Password Security
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_HISTORY_LIMIT=5

# User Activity Event Retention
USER_ACTIVITY_RETENTION_DAYS=90
USER_ACTIVITY_HEARTBEAT_MINUTES=15
USER_ACTIVITY_DAILY_RETENTION_DAYS=730

# Database Client Selection: 'sqlite' (default, local dev) or 'pg' (production)
DB_CLIENT=sqlite

# SQLite (used when DB_CLIENT=sqlite)
DB_PATH=data/dashboard.db

# PostgreSQL (used when DB_CLIENT=pg)
# For Supabase: Project Settings -> Database -> Connection string ("URI" tab
# has the individual host/port/user/password/database fields broken out too).
# Use the "Session pooler" host/port (not "Transaction pooler") -- this app
# keeps a small long-lived connection pool, which the session pooler supports
# cleanly; the transaction pooler restricts prepared statements Knex relies on.
# Supabase requires SSL, so DB_SSL must be true.
DB_HOST=localhost
DB_PORT=5432
DB_USER=vessel_dashboard
DB_PASSWORD=change-me
DB_NAME=vessel_dashboard
DB_SSL=false
# Supabase: download the database CA from Settings > Database > SSL.
# Mount this public certificate as a deployment file and enable verification.
# DB_SSL_CA_FILE=/etc/secrets/supabase-ca.crt
DB_SSL_VERIFY=true

# Production runs migrations separately using vessel_migrator credentials.
RUN_MIGRATIONS_ON_STARTUP=false
ALLOW_INITIAL_SEED=false

# Superadmin bootstrap (REQUIRED the first time the users table is empty)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me-now1

# Optional demo accounts for local dev only (opt-in, off by default)
SEED_DEMO_ACCOUNTS=false
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# OPERATOR_USERNAME=operator
# OPERATOR_PASSWORD=
# VIEWER_USERNAME=viewer
# VIEWER_PASSWORD=
